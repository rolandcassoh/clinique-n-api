# Application
APP_NAME="Gestion Clinique API"
APP_ENV=development
APP_SECRET_KEY=change-this-secret-key-in-production

# Database
DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/clinique_dev
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# JWT
JWT_SECRET_KEY=change-this-jwt-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:4200"]

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@clinique.app

# Encryption
ENCRYPTION_KEY=change-this-32-bytes-encryption-key
